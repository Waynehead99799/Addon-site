# Copy to `.env.local` and fill in real values. Restart the dev server after
# changing any of these — Next.js only reads env vars at start-up.

# ---------- Google reCAPTCHA v3 (Enquire-form captcha) ----------
# Console: https://www.google.com/recaptcha/admin
# Register a v3 key for your domain, then paste the site key (public, ships
# to the browser) and the secret (server-only, used by /api/contact for
# siteverify). Both keys start with `6L...` and are 40 chars long. v3 is
# silent — there's no checkbox; Google scores user behaviour 0.0 (bot) →
# 1.0 (human) and the API route rejects scores below RECAPTCHA_MIN_SCORE
# (default 0.5, see app/api/contact/route.ts).
# When BOTH are unset, the front-end skips loading reCAPTCHA AND the API
# route skips verification — handy for local dev without keys.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------- Email delivery (Resend) ----------
# Sign up: https://resend.com — free tier is 3,000 emails / month.
# When RESEND_API_KEY is unset, the API route logs each submission to the
# server console instead of sending mail. Useful for staging without a key,
# but never ship to production without one.
RESEND_API_KEY=

# Inbox that receives Enquire submissions. Falls back to SITE.email
# (sales@addonwebsolutions.com) when unset.
CONTACT_TO_EMAIL=

# Verified Resend sender. Until your production domain is verified in Resend,
# leave blank — `lib/contact.ts` falls back to the Resend sandbox sender
# (onboarding@resend.dev), which only delivers to the account owner's email.
# After verifying e.g. addonwebsolutions.com in Resend, switch this to
# something like: "Addon Web Solutions <hi@addonwebsolutions.com>"
CONTACT_FROM_EMAIL=
